<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On
    RewriteBase /invoices/

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # If the request is for a real file in public, serve it
    RewriteCond %{REQUEST_URI} !^/invoices/public/
    RewriteCond %{DOCUMENT_ROOT}/invoices/public%{REQUEST_URI} -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/invoices/public%{REQUEST_URI} -d
    RewriteRule ^(.*)$ public/$1 [L]

    # Otherwise route to public/index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ public/index.php [QSA,L]
</IfModule>
